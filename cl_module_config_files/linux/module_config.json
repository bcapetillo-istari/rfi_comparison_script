{
  "CompareRfiResponseTables": {
    "executable": "$RFI_MODULE_DIR/scripts/rfi_compare",
    "arguments": [
      "\"$system_id\"",
      "--rfi-file",
      "\"$input_model\"",
      "--auth-file",
      "\"$auth_info\""
    ],
    "hidden_parameters": [],
    "environment": {
      "RFI_MODULE_DIR": "/opt/local/istari_agent/istari_modules/rfi_comparison_module",
      "EXTRACT_FUNCTION": "@istari:extract_tables",
      "ISTARI_API_URL": "https://fileservice-v2.dev.istari.app",
      "DEFAULT_JOB_TIMEOUT_S": "3600"
    }
  }
}