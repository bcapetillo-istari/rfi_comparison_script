{
  "CompareRfiResponses": {
    "executable": "$RFI_MODULE_DIR/scripts/run_rfi_compare.sh",
    "arguments": [
      "\"$system_id\"",
      "--rfi-file",
      "\"$input_model\""
    ],
    "hidden_parameters": [],
    "environment": {
      "RFI_MODULE_DIR": "/opt/local/istari_agent/istari_modules/rfi_comparison_module",
      "EXTRACT_FUNCTION": "@istari:extract_tables",
      "ISTARI_API_URL": "https://api.dev.istari.app",
      "ISTARI_CREDENTIALS_PATH": ".istari_credentials.json",
      "DEFAULT_JOB_TIMEOUT_S": "3600"
    }
  }
}